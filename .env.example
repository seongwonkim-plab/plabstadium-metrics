# Plab 데이터 게이트웨이
PLAB_API_URL=https://data-gateway.preview.plabfootball.com
PLAB_API_KEY=

# Google Sheets - 스타디움 지표
GOOGLE_SHEETS_ID=

# 로컬 개발: 서비스 계정 파일 경로
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./.secrets/service-account.json

# 배포 환경 (Vercel 등): 위 파일의 내용을 통째로 아래 env 에 붙여넣기
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# 대시보드 접근 통제
# 팀원과 공유할 로그인 비밀번호 (임의의 강한 문자열)
DASHBOARD_PASSWORD=change-me
# 세션 쿠키 서명용 시크릿 (openssl rand -hex 32 로 생성)
DASHBOARD_AUTH_SECRET=change-me-with-a-random-32-byte-hex-string
